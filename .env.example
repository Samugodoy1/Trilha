# Postgres de produção (Neon, Supabase, RDS...). Sem esta variável, o Trilha usa
# um Postgres embutido (PGlite) em .data/ — ideal para demonstração local.
DATABASE_URL=postgresql://trilha:trilha@localhost:5432/trilha

# Pasta privada para fotos e documentos (fora de /public). Em produção, troque o
# driver em src/server/storage.ts por um bucket privado.
STORAGE_DIR=.data/uploads

# Opcional: habilita a redação assistida com Claude. Os dados são pseudonimizados
# antes do envio. Sem chave, o assistente usa apenas o motor local, sem enviar nada.
ANTHROPIC_API_KEY=
